# OCI Staging Environment Variables Example
# Copy this file to .env and fill in your values
# Then: source .env

# ============================================================================
# OCI Authentication (Config File Profile)
# ============================================================================
# The OCI provider will read credentials from ~/.oci/config
# You just need to specify which profile to use (defaults to DEFAULT)
export TG_VAR_oci_config_profile="DEFAULT"

# ============================================================================
# OCI Resource Identifiers
# ============================================================================
# These are still needed as module inputs (not for authentication)
# Get from: oci iam compartment list --all
export TG_VAR_oci_tenancy_ocid="ocid1.tenancy.oc1..aaaaaaaxxxxxx"
export TG_VAR_oci_compartment_id="ocid1.compartment.oc1..aaaaaaaxxxxxx"

# ============================================================================
# Terraform State Backend (S3)
# ============================================================================
export TG_STATE_BUCKET="your-terraform-backend-bucket"
export TG_STATE_LOCK_TABLE="your-terraform-locks-table"
export TG_VAR_region="us-east-1"  # For S3 backend

# ============================================================================
# SSH Access
# ============================================================================
# Generate with: ssh-keygen -t rsa -b 4096 -f ~/.ssh/oci_staging_key
# This is for SSH access to VMs (edge proxy, worker nodes via bastion)
export TG_VAR_ssh_public_key="$(cat ~/.ssh/oci_staging_key.pub)"

# ============================================================================
# OCI API Authentication (from ~/.oci/config)
# ============================================================================
# If you have an encrypted private key, create an unencrypted version:
# openssl rsa -in ~/.oci/oci_api_key.pem -out ~/.oci/oci_api_key_nopass.pem
# Then use the unencrypted key:
export TG_VAR_oci_user_ocid="$(grep ^user ~/.oci/config | cut -d= -f2)"
export TG_VAR_oci_fingerprint="$(grep ^fingerprint ~/.oci/config | cut -d= -f2)"
export TG_VAR_oci_private_key_path="$HOME/.oci/oci_api_key_nopass.pem"
# Leave password empty if using unencrypted key:
export TG_VAR_oci_private_key_password=""

# ============================================================================
# Bastion Access Control
# ============================================================================
# Comma-separated list of IPs allowed to create bastion sessions
# Get your IP: curl ifconfig.me
export TG_VAR_bastion_allowed_cidrs="$(curl -s ifconfig.me)/32"
# Or allow multiple IPs:
# export TG_VAR_bastion_allowed_cidrs="1.2.3.4/32,5.6.7.8/32"

# ============================================================================
# GitOps (ArgoCD)
# ============================================================================
# Personal Access Token for private Git repositories
export TG_VAR_git_token="ghp_xxxxxxxxxxxxx"

# ============================================================================
# Project Metadata (Optional)
# ============================================================================
export TG_VAR_owner="akthmd"
export TG_VAR_app_name="portfolio-platform"

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. Install OCI CLI: https://docs.oracle.com/en-us/iaas/Content/API/SDKDocs/cliinstall.htm
# 2. Configure OCI CLI: oci setup config
#    - This creates ~/.oci/config with your credentials
#    - Choose a profile name (DEFAULT is standard)
# 3. Fill in the values above
# 4. Source this file: source .env
# 5. Deploy: 
#    cd network && terragrunt apply
#    cd ../bastion && terragrunt apply
#    cd ../cluster && terragrunt apply
#    cd ../nodepool && terragrunt apply
#    cd ../addons && terragrunt apply
#    cd ../cluster-services && terragrunt apply
#    cd ../edge-proxy && terragrunt apply
