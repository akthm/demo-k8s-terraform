apiVersion: v1
kind: Config
clusters:
- cluster:
    server: https://127.0.0.1:6443
    insecure-skip-tls-verify: true
  name: bastion-tunnel
contexts:
- context:
    cluster: bastion-tunnel
    user: bastion-tunnel-user
  name: bastion-tunnel
current-context: bastion-tunnel
users:
- name: bastion-tunnel-user
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: oci
      args:
        - ce
        - cluster
        - generate-token
        - --cluster-id
        - "ocid1.cluster.oc1.il-jerusalem-1.aaaaaaaajy4hwcxv2nk5clftclqyly4fjohx3sfduksy3ff5ucputrcdhzmq"
        - --region
        - "il-jerusalem-1"
